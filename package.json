{
  "name": "riml-ds",
  "private": true,
  "workspaces": [
    "system/*",
    "library/*",
    "tools/*",
    "apps/*",
    "e2e*",
    "e2e/*",
    "!tools/markuplint"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "build": "bun run --filter './system/*' build && bun run --filter @rimltempest/riml-ds-elements build && bun run gen && bun run --filter @rimltempest/riml-ds-react build && bun run --filter @rimltempest/riml-ds-vue build && bun run --filter @rimltempest/riml-ds-astro build",
    "design-md": "bun run --filter @rimltempest/riml-ds-design-md generate",
    "gen": "bun run --filter @rimltempest/riml-ds-elements gen && bun run tools/cem/src/registry.ts && bunx oxfmt tools/cem/registry.json && bun run tools/cem/src/wrappers/index.ts",
    "lint:tokens": "bun run --filter @rimltempest/riml-ds-tokens check",
    "lint": "oxlint --type-aware --ignore-pattern 'tools/lint/test/fixtures/**'",
    "lint:fix": "oxlint --type-aware --fix --ignore-pattern 'tools/lint/test/fixtures/**'",
    "lint:css": "stylelint --config tools/lint/stylelint.config.js --allow-empty-input 'system/css/src/**/*.css' 'library/elements/src/**/*.css' 'library/elements/src/**/*.styles.ts' 'apps/storybook/**/*.css'",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run fmt:check && bun run lint && bun run lint:css && bun run typecheck && bun run lint:tokens && bunx sherif",
    "guard": "./scripts/guard.sh",
    "wt": "./scripts/wt.sh",
    "prepare": "lefthook install",
    "postinstall": "bun install --cwd tools/markuplint --frozen-lockfile || bun install --cwd tools/markuplint",
    "clean": "find . -maxdepth 3 -name node_modules -type d -prune -exec rm -rf {} + && bun install",
    "e2e:frameworks": "playwright test -c e2e/playwright.frameworks.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@guidepup/virtual-screen-reader": "0.32.1",
    "@playwright/test": "1.63.0",
    "@size-limit/esbuild": "13.0.3",
    "@size-limit/file": "13.0.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.63.0",
    "postcss-lit": "1.4.1",
    "sherif": "1.13.0",
    "size-limit": "13.0.3",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26"
  },
  "packageManager": "bun@1.4.0"
}
