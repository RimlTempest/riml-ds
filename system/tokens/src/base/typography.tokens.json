{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Hiragino Sans",
          "Noto Sans JP",
          "sans-serif"
        ],
        "$description": "本文と見出しの既定の書体。OS の UI 書体に合わせる"
      },
      "display": {
        "$value": [
          "Zen Maru Gothic",
          "M PLUS Rounded 1c",
          "Hiragino Maru Gothic ProN",
          "Kosugi Maru",
          "Arial Rounded MT Bold",
          "Nunito",
          "system-ui",
          "sans-serif"
        ],
        "$description": "見出しとタイトルバーの丸ゴシック系スタック。フォントは同梱しない（入っていれば効く）"
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "Consolas",
          "Noto Sans Mono CJK JP",
          "monospace"
        ],
        "$description": "コードと等幅で読ませたい値の書体"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "本文の太さ"
      },
      "bold": {
        "$value": 700,
        "$description": "見出しと強調の太さ"
      }
    }
  },
  "line": {
    "height": {
      "$type": "number",
      "body": {
        "$value": 1.6,
        "$description": "本文の行間（WCAG 1.4.8 の 1.5 以上）"
      },
      "heading": {
        "$value": 1.2,
        "$description": "大見出しの行間"
      },
      "heading-2": {
        "$value": 1.25,
        "$description": "中見出しの行間"
      },
      "small": {
        "$value": 1.5,
        "$description": "補助テキストと等幅の行間"
      },
      "display": {
        "$value": 1.1,
        "$description": "ヒーロー見出し（type.display）の行間。大きい文字ほど行間は詰める"
      }
    }
  },
  "letter": {
    "spacing": {
      "$type": "dimension",
      "normal": {
        "$value": {
          "value": 0,
          "unit": "em"
        },
        "$description": "字間を触らない既定。継承した字間を打ち消したいときに明示する"
      },
      "wide": {
        "$value": {
          "value": 0.12,
          "unit": "em"
        },
        "$description": "キャプションとラベルの広い字間。欧数字・かなの短い語だけに使う（本文には使わない）"
      }
    }
  }
}
