{
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{line.height.display}"
      },
      "$description": "ヒーローと数字 1 つの窓の特大見出し。1 画面に 1 つだけ置く",
      "$extensions": {
        "riml-ds": {
          "fluid": {
            "min": "2.5rem",
            "preferred": "1.6rem + 3vw",
            "max": "4rem"
          }
        }
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{line.height.body}"
      },
      "$description": "本文の既定の組み。段落・ラベル・ボタンの文字",
      "$extensions": {
        "riml-ds": {
          "fluid": {
            "min": "1rem",
            "preferred": "0.96rem + 0.2vw",
            "max": "1.125rem"
          }
        }
      }
    },
    "heading": {
      "1": {
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": {
            "value": 1.75,
            "unit": "rem"
          },
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{line.height.heading}"
        },
        "$description": "ページに 1 つの大見出し",
        "$extensions": {
          "riml-ds": {
            "fluid": {
              "min": "1.75rem",
              "preferred": "1.4rem + 1.5vw",
              "max": "2.5rem"
            }
          }
        }
      },
      "2": {
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": {
            "value": 1.375,
            "unit": "rem"
          },
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{line.height.heading-2}"
        },
        "$description": "節の見出し",
        "$extensions": {
          "riml-ds": {
            "fluid": {
              "min": "1.375rem",
              "preferred": "1.2rem + 0.9vw",
              "max": "1.875rem"
            }
          }
        }
      },
      "3": {
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": {
            "value": 1.125,
            "unit": "rem"
          },
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{line.height.heading-2}"
        },
        "$description": "小節の見出し",
        "$extensions": {
          "riml-ds": {
            "fluid": {
              "min": "1.125rem",
              "preferred": "1.05rem + 0.35vw",
              "max": "1.375rem"
            }
          }
        }
      },
      "4": {
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": {
            "value": 1,
            "unit": "rem"
          },
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{line.height.heading-2}"
        },
        "$description": "窓・カードの中の見出し。幅で大きさを変えない"
      }
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{line.height.small}"
      },
      "$description": "補助テキスト。本文より小さくしてよい下限（14px）"
    },
    "link": {
      "underline-offset": {
        "$type": "dimension",
        "$value": {
          "value": 0.15,
          "unit": "em"
        },
        "$description": "リンクの下線と文字の隙間。ディセンダーに重ならない最小値"
      }
    },
    "mono": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": {
          "value": 0.9375,
          "unit": "rem"
        },
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{line.height.small}"
      },
      "$description": "コードと桁を揃えたい値の組み"
    }
  }
}
