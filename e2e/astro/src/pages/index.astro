---
import RdButton from '@rimltempest/riml-ds-astro/button.astro'
import RdCheckbox from '@rimltempest/riml-ds-astro/experimental/checkbox.astro'
import RdCheckboxGroup from '@rimltempest/riml-ds-astro/experimental/checkbox-group.astro'
import RdCombobox from '@rimltempest/riml-ds-astro/experimental/combobox.astro'
import RdCommand from '@rimltempest/riml-ds-astro/experimental/command.astro'
import RdDataTable from '@rimltempest/riml-ds-astro/experimental/data-table.astro'
import RdInputOtp from '@rimltempest/riml-ds-astro/experimental/input-otp.astro'
import RdSelect from '@rimltempest/riml-ds-astro/experimental/select.astro'
import RdDialog from '@rimltempest/riml-ds-astro/dialog.astro'
import RdTextField from '@rimltempest/riml-ds-astro/text-field.astro'
import RdMenu from '@rimltempest/riml-ds-astro/experimental/menu.astro'
import RdMeter from '@rimltempest/riml-ds-astro/experimental/meter.astro'
import RdPopover from '@rimltempest/riml-ds-astro/experimental/popover.astro'
import RdRadioGroup from '@rimltempest/riml-ds-astro/experimental/radio-group.astro'
import RdSlider from '@rimltempest/riml-ds-astro/experimental/slider.astro'
import RdTabs from '@rimltempest/riml-ds-astro/experimental/tabs.astro'
import RdToggle from '@rimltempest/riml-ds-astro/experimental/toggle.astro'
import RdWindow from '@rimltempest/riml-ds-astro/experimental/window.astro'
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>riml-ds Astro e2e</title>
  </head>
  <body>
    <div id="root">
      <main>
        <h1>お問い合わせ</h1>
        <form id="contact" method="get" action="/thanks.html">
          <RdTextField label="メール" name="email" type="email" required hint="確認メールを送ります" />
          <RdSelect label="国" name="country">
            <option value="">選択してください</option>
            <option value="jp">日本</option>
            <option value="us">アメリカ</option>
          </RdSelect>
          <RdCheckbox label="お知らせを受け取る" name="news" defaultValue="yes" />
          <RdButton type="submit">送信</RdButton>
        </form>
        <RdDialog label="送信しました" placement="end"><p>確認メールを送りました。</p></RdDialog>
        <RdMeter id="disk" label="ディスク使用量" value="3.2" max="10" text="3.2 GB / 10 GB" />
        <RdWindow title="バックアップの設定" collapsible><p>毎晩 3 時に実行します。</p></RdWindow>
        <RdRadioGroup label="プラン">
          <label><input type="radio" id="plan-free" name="plan" value="free" />無料</label>
          <label><input type="radio" id="plan-pro" name="plan" value="pro" />有料</label>
        </RdRadioGroup>
        <RdSlider id="volume" label="音量" name="volume" defaultValue="3" min="0" max="10" />
        <RdTabs label="ドキュメント">
          <Fragment slot="tabs"><a href="#overview">概要</a><a href="#usage">使い方</a></Fragment>
          <Fragment slot="panels"
            ><div id="overview"><p>この部品の概要。</p></div><div id="usage">
              <p>使い方の説明。</p>
            </div></Fragment
          >
        </RdTabs>
        <RdMenu label="操作" id="row-actions">
          <rd-button slot="trigger"
            ><button type="button" popovertarget="row-actions">操作</button></rd-button
          >
          <Fragment slot="items"
            ><a href="/thanks.html">複製</a><button type="button">削除</button></Fragment
          >
        </RdMenu>
        <RdPopover id="filters" label="絞り込み">
          <rd-button slot="trigger"
            ><button type="button" popovertarget="filters">絞り込み</button></rd-button
          >
          <p>条件を選ぶと一覧がその場で変わる。</p>
        </RdPopover>
        <RdCheckboxGroup label="タグ">
          <label><input type="checkbox" id="tag-work" name="tags" value="a" />仕事</label>
          <label><input type="checkbox" id="tag-private" name="tags" value="b" />私用</label>
        </RdCheckboxGroup>
        <RdInputOtp label="確認コード">
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]"
            maxlength="1"
            id="code-1"
            name="code-1"
            aria-label="1 桁目"
            title="0〜9 の数字 1 文字"
            required
            autocomplete="one-time-code"
          />
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]"
            maxlength="1"
            id="code-2"
            name="code-2"
            aria-label="2 桁目"
            title="0〜9 の数字 1 文字"
            required
          />
        </RdInputOtp>
        <RdCombobox id="reading" listId="reading-list" label="読み" name="reading">
          <option value="kana">かな</option>
          <option value="kanji">かんじ</option>
          <option value="romaji">ローマ字</option>
        </RdCombobox>
        <RdCommand id="palette" label="コマンド">
          <Fragment slot="groups"
            ><ul aria-label="ページ">
              <li><a href="#home" data-keywords="home top">ホーム</a></li>
              <li><a href="#settings" data-keywords="せってい preferences">設定</a></li>
            </ul><ul aria-label="操作">
              <li>
                <button type="button" value="new">新しいノート<kbd class="rd-kbd">⌘N</kbd></button>
              </li>
            </ul></Fragment
          >
        </RdCommand>
        <RdDataTable caption="保存したコード">
          <thead slot="head"
            ><tr
              ><th scope="col" data-sort="text" data-key="name">名前</th><th
                scope="col"
                data-sort="number"
                data-key="size"
                data-numeric=""
              >サイズ</th></tr
            ></thead
          >
          <tbody slot="body"
            ><tr><td>b.png</td><td data-value="1234" data-numeric="">1,234</td></tr><tr
              ><td>a.png</td><td data-value="820" data-numeric="">820</td></tr
            ></tbody
          >
        </RdDataTable>
        <RdToggle label="太字" pressed="false" />
        <rd-live-region></rd-live-region>
      </main>
    </div>
    <script>
      document.addEventListener('submit', (event) => {
        const form = event.target
        if (!(form instanceof HTMLFormElement) || form.id !== 'contact') {
          return
        }
        event.preventDefault()
        const dialog = document.querySelector('rd-dialog')
        if (dialog !== null && 'show' in dialog && typeof dialog.show === 'function') {
          dialog.show()
        }
      })
    </script>
  </body>
</html>
