{
  "$schema": "https://raw.githubusercontent.com/markuplint/markuplint/main/config.schema.json",
  "extends": ["markuplint:recommended"],
  "parser": {
    "\\.html$": "@markuplint/html-parser"
  },
  "rules": {
    "require-accessible-name": true,
    "wai-aria": {
      "options": {
        "checkingValue": true,
        "checkingDeprecatedProps": true
      }
    },
    "landmark-roles": {
      "options": {
        "ignoreRoles": []
      }
    },
    "required-h1": false,
    "heading-levels": true,
    "no-refer-to-non-existent-id": true,
    "label-has-control": true,
    "use-list": true,
    "no-empty-palpable-content": true,
    "no-hard-code-id": false,
    "attr-duplication": true,
    "character-reference": false,
    "class-naming": false,
    "permitted-contents": true,
    "invalid-attr": {
      "options": {
        "disallowAttrs": ["accesskey"],
        "allowAttrs": [
          {
            "name": "tabindex",
            "value": {
              "enum": ["-1", "0"]
            }
          },
          {
            "name": "part",
            "value": "Any"
          },
          {
            "name": "exportparts",
            "value": "Any"
          }
        ]
      }
    }
  },
  "nodeRules": [
    {
      "selector": "button[aria-label]",
      "rules": {
        "no-empty-palpable-content": false
      }
    },
    {
      "selector": "input[type=\"checkbox\"][role=\"switch\"]",
      "rules": {
        "wai-aria": false
      }
    },
    {
      "selector": "template[shadowrootmode] *",
      "rules": {
        "id-duplication": false
      }
    },
    {
      "selector": "img",
      "rules": {
        "required-attr": ["alt"]
      }
    },
    {
      "selector": ":where(video, audio)",
      "rules": {
        "required-element": ["track"]
      }
    }
  ],
  "excludeFiles": ["**/node_modules/**", "**/dist/**"]
}
