{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/lint/oxlint-plugin/index.js"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off"
  },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "riml-ds/no-class": "error",
    "riml-ds/no-type-assertion": "error",
    "riml-ds/no-enum": "error",

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-extraneous-class": "error",
    "typescript/switch-exhaustiveness-check": "error",
    // union を網羅した switch は TS が「全経路が返る」と理解するが、この規則は
    // 理解しない。default を足すと網羅チェックが効かなくなり、拡張性の担保
    // （メンバー追加でコンパイルエラー）が壊れる。tsconfig の noImplicitReturns
    // が本当の返し忘れを検出するので、こちらは無効にする。
    "typescript/consistent-return": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",

    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-param-reassign": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "eslint/no-shadow": "error",
    "eslint/default-param-last": "error",
    "eslint/prefer-object-spread": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-array-for-each": "off",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",

    "import/no-cycle": "error",
    "import/no-default-export": "error"
  },
  "overrides": [
    {
      // 純関数・ドメイン層では throw しない。失敗は Result で返す
      "files": [
        "library/elements/src/**/*.logic.ts",
        "library/elements/src/**/*.contract.ts",
        "library/elements/src/_shared/**/*.ts",
        "system/tokens/src/**/*.ts",
        "tools/*/src/core/**/*.ts",
        "system/tokens/scripts/core/**/*.ts",
        "tools/*/scripts/core/**/*.ts"
      ],
      "rules": { "riml-ds/no-throw-in-domain": "error" }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/test/**", "**/e2e/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "eslint/no-console": "off",
        "import/no-default-export": "off",
        "riml-ds/no-throw-in-domain": "off"
      }
    },
    {
      // lint 設定のテスト用 fixture。意図的に規約を破っているので既定の実行では
      // --ignore-pattern で外し（package.json / lefthook.yml）、テストだけが
      // 明示的に検査する。上の test 緩和を実ソースと同じ厳しさに戻す。
      "files": ["tools/lint/test/fixtures/**/*.ts"],
      "rules": { "import/no-default-export": "error" }
    },
    {
      // fixture は本物のドメイン層の配置を写している。overrides の files が
      // 効いていることを確かめるため、同じルールをここでも有効にする。
      "files": ["tools/lint/test/fixtures/library/elements/src/**/*.logic.ts"],
      "rules": { "riml-ds/no-throw-in-domain": "error" }
    },
    {
      // CSF3 の story、設定ファイル、Storybook 設定、oxlint プラグインは default export が規約
      "files": [
        "**/*.stories.ts",
        "**/*.config.ts",
        "**/*.config.js",
        "**/.storybook/**",
        "tools/lint/**/*.js",
        "**/terrazzo.config.ts",
        "**/playwright.config.ts"
      ],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["scripts/**/*.ts", "tools/*/src/cli.ts"],
      "rules": { "eslint/no-console": "off" }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/*.d.ts",
    "**/node_modules/**",
    "**/src/generated/**",
    "**/storybook-static/**",
    ".agents/skills/**",
    ".claude/skills/**"
  ]
}
