{
  "name": "@rimltempest/riml-ds-astro",
  "version": "0.2.0",
  "description": "riml-ds の Astro integration と .astro 部品。CEM とマークアップ契約から生成する",
  "license": "MIT",
  "files": [
    "dist",
    "src/generated",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button.astro": "./src/generated/button.astro",
    "./dialog.astro": "./src/generated/dialog.astro",
    "./text-field.astro": "./src/generated/text-field.astro",
    "./experimental/checkbox.astro": "./src/generated/experimental/checkbox.astro",
    "./experimental/checkbox-group.astro": "./src/generated/experimental/checkbox-group.astro",
    "./experimental/combobox.astro": "./src/generated/experimental/combobox.astro",
    "./experimental/command.astro": "./src/generated/experimental/command.astro",
    "./experimental/data-table.astro": "./src/generated/experimental/data-table.astro",
    "./experimental/disclosure.astro": "./src/generated/experimental/disclosure.astro",
    "./experimental/input-otp.astro": "./src/generated/experimental/input-otp.astro",
    "./experimental/menu.astro": "./src/generated/experimental/menu.astro",
    "./experimental/meter.astro": "./src/generated/experimental/meter.astro",
    "./experimental/popover.astro": "./src/generated/experimental/popover.astro",
    "./experimental/radio-group.astro": "./src/generated/experimental/radio-group.astro",
    "./experimental/select.astro": "./src/generated/experimental/select.astro",
    "./experimental/slider.astro": "./src/generated/experimental/slider.astro",
    "./experimental/splitter.astro": "./src/generated/experimental/splitter.astro",
    "./experimental/tabs.astro": "./src/generated/experimental/tabs.astro",
    "./experimental/toggle.astro": "./src/generated/experimental/toggle.astro",
    "./experimental/toggle-group.astro": "./src/generated/experimental/toggle-group.astro",
    "./experimental/window.astro": "./src/generated/experimental/window.astro",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "astro": "7.3.1"
  },
  "peerDependencies": {
    "@rimltempest/riml-ds-css": "workspace:*",
    "@rimltempest/riml-ds-elements": "workspace:*",
    "@rimltempest/riml-ds-tokens": "workspace:*",
    "astro": "^7.0.0"
  }
}
