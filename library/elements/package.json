{
  "name": "@rimltempest/riml-ds-elements",
  "version": "0.2.0",
  "description": "riml-ds の Web Components（Lit）。唯一のソース",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/types",
    "custom-elements.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/**/*.define.js",
    "./dist/**/*.css",
    "./src/**/*.define.ts",
    "./src/**/*.css"
  ],
  "exports": {
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./button/contract": {
      "types": "./dist/button/button.contract.d.ts",
      "default": "./dist/button/button.contract.js"
    },
    "./button/define": {
      "types": "./dist/button/button.define.d.ts",
      "default": "./dist/button/button.define.js"
    },
    "./button/style.css": "./dist/button/button.css",
    "./text-field": {
      "types": "./dist/text-field/index.d.ts",
      "default": "./dist/text-field/index.js"
    },
    "./text-field/contract": {
      "types": "./dist/text-field/text-field.contract.d.ts",
      "default": "./dist/text-field/text-field.contract.js"
    },
    "./text-field/define": {
      "types": "./dist/text-field/text-field.define.d.ts",
      "default": "./dist/text-field/text-field.define.js"
    },
    "./text-field/style.css": "./dist/text-field/text-field.css",
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "default": "./dist/dialog/index.js"
    },
    "./dialog/contract": {
      "types": "./dist/dialog/dialog.contract.d.ts",
      "default": "./dist/dialog/dialog.contract.js"
    },
    "./dialog/define": {
      "types": "./dist/dialog/dialog.define.d.ts",
      "default": "./dist/dialog/dialog.define.js"
    },
    "./dialog/style.css": "./dist/dialog/dialog.css",
    "./live-region": {
      "types": "./dist/live-region/index.d.ts",
      "default": "./dist/live-region/index.js"
    },
    "./live-region/define": {
      "types": "./dist/live-region/live-region.define.d.ts",
      "default": "./dist/live-region/live-region.define.js"
    },
    "./experimental/select": {
      "types": "./dist/experimental/select/index.d.ts",
      "default": "./dist/experimental/select/index.js"
    },
    "./experimental/select/contract": {
      "types": "./dist/select/select.contract.d.ts",
      "default": "./dist/select/select.contract.js"
    },
    "./experimental/select/define": {
      "types": "./dist/select/select.define.d.ts",
      "default": "./dist/select/select.define.js"
    },
    "./experimental/select/style.css": "./dist/select/select.css",
    "./experimental/checkbox": {
      "types": "./dist/experimental/checkbox/index.d.ts",
      "default": "./dist/experimental/checkbox/index.js"
    },
    "./experimental/checkbox/contract": {
      "types": "./dist/checkbox/checkbox.contract.d.ts",
      "default": "./dist/checkbox/checkbox.contract.js"
    },
    "./experimental/checkbox/define": {
      "types": "./dist/checkbox/checkbox.define.d.ts",
      "default": "./dist/checkbox/checkbox.define.js"
    },
    "./experimental/checkbox/style.css": "./dist/checkbox/checkbox.css",
    "./experimental/disclosure": {
      "types": "./dist/experimental/disclosure/index.d.ts",
      "default": "./dist/experimental/disclosure/index.js"
    },
    "./experimental/disclosure/contract": {
      "types": "./dist/disclosure/disclosure.contract.d.ts",
      "default": "./dist/disclosure/disclosure.contract.js"
    },
    "./experimental/disclosure/define": {
      "types": "./dist/disclosure/disclosure.define.d.ts",
      "default": "./dist/disclosure/disclosure.define.js"
    },
    "./experimental/disclosure/style.css": "./dist/disclosure/disclosure.css",
    "./experimental/toast": {
      "types": "./dist/experimental/toast/index.d.ts",
      "default": "./dist/experimental/toast/index.js"
    },
    "./experimental/toast/define": {
      "types": "./dist/toast/toast.define.d.ts",
      "default": "./dist/toast/toast.define.js"
    },
    "./styles.css": "./dist/styles.css",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run scripts/copy-css.ts",
    "gen": "cem analyze --config custom-elements.config.js",
    "test": "vitest run --root ../.. --project node --project browser library/elements"
  },
  "dependencies": {
    "lit": "3.3.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0"
  },
  "peerDependencies": {
    "@rimltempest/riml-ds-tokens": "workspace:*"
  },
  "customElements": "custom-elements.json"
}
